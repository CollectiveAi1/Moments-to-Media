# Both values are public by design: the anon key only ever acts as the signed-in
# user, and row-level security decides what that user can read. The one server
# key below is used for the sign-in throttle only, never for reading data
# (CLAUDE.md rule 4: server keys live in Vercel env, never in code).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>

# Server only, never NEXT_PUBLIC_. Used solely by the sign-in throttle
# (lib/supabase/service.ts). Without it the throttle is skipped and logged.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Where emailed links (sign-up, password reset) send people back to. Set it for
# local development; production defaults to the live site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
