# Both values are public by design: the anon key only ever acts as the signed-in
# user, and row-level security decides what that user can read. No server key
# belongs in this app (CLAUDE.md rule 4).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>
