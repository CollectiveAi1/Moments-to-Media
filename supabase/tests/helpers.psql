-- Shared test fixtures and role switching.
--
-- Included by every test file with \ir helpers.psql. The extension is
-- deliberately named .psql, not .sql, so `supabase test db` does not try to
-- run it as a test of its own.
--
-- Everything here is created inside the test's transaction and disappears when
-- it rolls back, so no test scaffolding reaches a real database.

create extension if not exists pgtap with schema extensions;

create schema if not exists tests;

-- -------------------------------------------------------- role switching
-- pg_prove connects as the database owner, so SET ROLE in either direction is
-- allowed. Every setting is transaction-local.

create or replace function tests.as_db_owner()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '', true);
  perform set_config('role', 'postgres', true);
end;
$$;

create or replace function tests.as_user(p_user uuid)
returns void
language plpgsql
as $$
begin
  perform set_config(
    'request.jwt.claims',
    json_build_object('sub', p_user::text, 'role', 'authenticated', 'aud', 'authenticated')::text,
    true
  );
  perform set_config('role', 'authenticated', true);
end;
$$;

-- Rows one user can actually read, counted with that user's RLS in force and
-- the assertion itself left to run as the owner.
create or replace function tests.count_as(p_user uuid, p_query text)
returns bigint
language plpgsql
as $$
declare
  v_count bigint;
begin
  perform tests.as_user(p_user);
  execute format('select count(*) from (%s) as q', p_query) into v_count;
  perform tests.as_db_owner();
  return v_count;
end;
$$;

-- One scalar, read as that user.
create or replace function tests.value_as(p_user uuid, p_query text)
returns text
language plpgsql
as $$
declare
  v_value text;
begin
  perform tests.as_user(p_user);
  execute p_query into v_value;
  perform tests.as_db_owner();
  return v_value;
end;
$$;

-- 'NO_ERROR', or the SQLSTATE the statement raised for that user. Used for the
-- denied half of every policy pair and for illegal state transitions.
create or replace function tests.error_as(p_user uuid, p_statement text)
returns text
language plpgsql
as $$
declare
  v_state text := null;
begin
  perform tests.as_user(p_user);
  begin
    execute p_statement;
  exception
    when others then v_state := sqlstate;
  end;
  perform tests.as_db_owner();
  return coalesce(v_state, 'NO_ERROR');
end;
$$;

-- Same, as the service role (background jobs and webhooks): no JWT at all.
create or replace function tests.error_as_service(p_statement text)
returns text
language plpgsql
as $$
declare
  v_state text := null;
begin
  perform set_config('request.jwt.claims', '', true);
  perform set_config('role', 'service_role', true);
  begin
    execute p_statement;
  exception
    when others then v_state := sqlstate;
  end;
  perform tests.as_db_owner();
  return coalesce(v_state, 'NO_ERROR');
end;
$$;

-- RLS filters an UPDATE or DELETE rather than failing it, so "denied" often
-- means "nothing happened". This counts what the statement actually touched.
create or replace function tests.rows_affected_as(p_user uuid, p_statement text)
returns bigint
language plpgsql
as $$
declare
  v_rows bigint := -1;
begin
  perform tests.as_user(p_user);
  begin
    execute p_statement;
    get diagnostics v_rows = row_count;
  exception
    when others then v_rows := -1;   -- refused outright (missing grant)
  end;
  perform tests.as_db_owner();
  return v_rows;
end;
$$;

-- ------------------------------------------------------------- the fixture

create table if not exists tests.fixture_ids (
  name text primary key,
  id   uuid not null
);

create or replace function tests.id(p_name text)
returns uuid
language plpgsql
stable
as $$
declare
  v_id uuid;
begin
  select f.id into v_id from tests.fixture_ids f where f.name = p_name;
  if v_id is null then
    raise exception 'no fixture id named %', p_name;
  end if;
  return v_id;
end;
$$;

create or replace function tests.new_user(p_name text, p_email text, p_full_name text)
returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (instance_id, id, aud, role, email, created_at, updated_at,
                          raw_app_meta_data, raw_user_meta_data)
  values ('00000000-0000-0000-0000-000000000000', v_id, 'authenticated', 'authenticated',
          p_email, now(), now(),
          '{"provider":"email","providers":["email"]}'::jsonb, '{}'::jsonb);

  insert into public.profiles (user_id, full_name, phone, email)
  values (v_id, p_full_name, '+15550100', p_email);

  insert into tests.fixture_ids (name, id) values (p_name, v_id);
  return v_id;
end;
$$;

/*
  tests.seed() builds two tenants.

  Organization A — "Moments to Media", in-app payments on, insurance required:
    owner_a, producer_a, producer_a2 (runs their own event),
    confirmed_contractor  — confirmed on slot_confirmed of event_a
    candidate_contractor  — opted in (interested) on slot_open of event_a
    eligible_contractor   — on no slot, but eligible for slot_open's open call
    outsider_contractor   — on no slot and not eligible (far away, no gear, no docs)

    client_a + client_contact_a
    event_a   (staffed, producer_a)  brief, on-site + emergency contacts, shot list,
              slot_confirmed (filled) and slot_open (open call),
              deliverable_a, upload_a, payout_a (draft), rating_a
    event_a2  (staffing, producer_a2) slot_a2 + assignment_a2 + upload_a2 + payout_a2
    announcement_a, notification_a, activity_a

  Organization B — "Other Media Co": owner_b, contractor_b, client_b, event_b
  with its own slot, assignment, upload and payout. Nothing in B may ever be
  visible to anyone in A.

  Geography: event_a sits in Phoenix; eligible and candidate contractors are
  nearby, the outsider is in New York.
*/
create or replace function tests.seed()
returns void
language plpgsql
as $$
declare
  v_org_a   uuid := gen_random_uuid();
  v_org_b   uuid := gen_random_uuid();
  v_phx_lat numeric := 33.448400;
  v_phx_lng numeric := -112.074000;
  v_owner_a uuid;
  v_prod_a  uuid;
  v_prod_a2 uuid;
  v_conf    uuid;
  v_cand    uuid;
  v_elig    uuid;
  v_out     uuid;
  v_owner_b uuid;
  v_cont_b  uuid;
  v_client_a uuid := gen_random_uuid();
  v_client_b uuid := gen_random_uuid();
  v_event_a uuid := gen_random_uuid();
  v_event_a2 uuid := gen_random_uuid();
  v_event_b uuid := gen_random_uuid();
  v_slot_confirmed uuid := gen_random_uuid();
  v_slot_open uuid := gen_random_uuid();
  v_slot_a2 uuid := gen_random_uuid();
  v_slot_b uuid := gen_random_uuid();
  v_assign_confirmed uuid := gen_random_uuid();
  v_assign_candidate uuid := gen_random_uuid();
  v_assign_a2 uuid := gen_random_uuid();
  v_assign_b uuid := gen_random_uuid();
  v_deliverable_a uuid := gen_random_uuid();
  v_upload_a uuid := gen_random_uuid();
  v_upload_a2 uuid := gen_random_uuid();
  v_upload_b uuid := gen_random_uuid();
  v_payout_a uuid := gen_random_uuid();
  v_payout_a2 uuid := gen_random_uuid();
  v_payout_b uuid := gen_random_uuid();
begin
  perform tests.as_db_owner();

  insert into tests.fixture_ids (name, id) values
    ('org_a', v_org_a), ('org_b', v_org_b),
    ('client_a', v_client_a), ('client_b', v_client_b),
    ('event_a', v_event_a), ('event_a2', v_event_a2), ('event_b', v_event_b),
    ('slot_confirmed', v_slot_confirmed), ('slot_open', v_slot_open),
    ('slot_a2', v_slot_a2), ('slot_b', v_slot_b),
    ('assign_confirmed', v_assign_confirmed), ('assign_candidate', v_assign_candidate),
    ('assign_a2', v_assign_a2), ('assign_b', v_assign_b),
    ('deliverable_a', v_deliverable_a),
    ('upload_a', v_upload_a), ('upload_a2', v_upload_a2), ('upload_b', v_upload_b),
    ('payout_a', v_payout_a), ('payout_a2', v_payout_a2), ('payout_b', v_payout_b);

  -- ---- organizations
  -- Slugs are derived from the generated ids. `supabase db reset` applies
  -- supabase/seed.sql before the suite runs, so a fixed slug would collide
  -- with the development seed's organization; the fixture must not assume an
  -- empty database.
  insert into public.organizations (id, name, slug, in_app_payments_enabled, settings)
  values (
    v_org_a, 'Test Org A', 'test-a-' || substr(replace(v_org_a::text, '-', ''), 1, 12), true,
    jsonb_build_object(
      'reminder_hours_before_call', jsonb_build_array(24, 2),
      'invite_window_hours', 24,
      'confirm_deadline_hours', 12,
      'payout_auto_approve_under_cents', 25000,
      'footage_retention_days', 90,
      'required_compliance_documents', jsonb_build_array('insurance')
    )
  );

  insert into public.organizations (id, name, slug, in_app_payments_enabled)
  values (v_org_b, 'Test Org B', 'test-b-' || substr(replace(v_org_b::text, '-', ''), 1, 12), false);

  -- ---- people
  v_owner_a := tests.new_user('owner_a', 'owner-a@example.test', 'Owner A');
  v_prod_a  := tests.new_user('producer_a', 'producer-a@example.test', 'Producer A');
  v_prod_a2 := tests.new_user('producer_a2', 'producer-a2@example.test', 'Producer A Two');
  v_conf    := tests.new_user('confirmed_contractor', 'confirmed@example.test', 'Casey Confirmed');
  v_cand    := tests.new_user('candidate_contractor', 'candidate@example.test', 'Quinn Candidate');
  v_elig    := tests.new_user('eligible_contractor', 'eligible@example.test', 'Eli Eligible');
  v_out     := tests.new_user('outsider_contractor', 'outsider@example.test', 'Ozzy Outsider');
  v_owner_b := tests.new_user('owner_b', 'owner-b@example.test', 'Owner B');
  v_cont_b  := tests.new_user('contractor_b', 'contractor-b@example.test', 'Bea Bravo');

  insert into public.memberships (org_id, user_id, role) values
    (v_org_a, v_owner_a, 'owner'),
    (v_org_a, v_prod_a, 'producer'),
    (v_org_a, v_prod_a2, 'producer'),
    (v_org_a, v_conf, 'contractor'),
    (v_org_a, v_cand, 'contractor'),
    (v_org_a, v_elig, 'contractor'),
    (v_org_a, v_out, 'contractor'),
    (v_org_b, v_owner_b, 'owner'),
    (v_org_b, v_cont_b, 'contractor');

  -- Contractor detail: the three nearby contractors are inside the radius and
  -- Stripe-ready; the outsider is in New York with no gear and no documents.
  insert into public.contractor_details
    (user_id, skills, home_base_latitude, home_base_longitude, travel_radius_miles,
     default_rate_cents, stripe_payouts_enabled)
  values
    (v_conf, '{video}', 33.450000, -112.070000, 50, 40000, true),
    (v_cand, '{photo}', 33.460000, -112.080000, 50, 35000, true),
    (v_elig, '{video,drone}', 33.470000, -112.060000, 50, 45000, true),
    (v_out,  '{photo}', 40.712800, -74.006000, 25, 30000, false);

  insert into public.equipment (user_id, category, make, model) values
    (v_conf, 'camera_body', 'Sony', 'FX3'),
    (v_cand, 'camera_body', 'Canon', 'R5'),
    (v_elig, 'camera_body', 'Sony', 'A7 IV');

  insert into public.compliance_documents (org_id, user_id, doc_type, status, expires_on) values
    (v_org_a, v_conf, 'insurance', 'approved', current_date + 180),
    (v_org_a, v_cand, 'insurance', 'approved', current_date + 180),
    (v_org_a, v_elig, 'insurance', 'approved', current_date + 180);

  -- ---- clients
  insert into public.clients (id, org_id, name) values
    (v_client_a, v_org_a, 'Desert Classic Invitational'),
    (v_client_b, v_org_b, 'Someone Else''s Client');

  insert into public.client_contacts (org_id, client_id, name, phone, email, is_primary) values
    (v_org_a, v_client_a, 'Dana Client', '+15550111', 'dana@client.test', true),
    (v_org_b, v_client_b, 'Bruno Client', '+15550222', 'bruno@client.test', true);

  -- ---- event A: staffed, one slot filled and one open call
  insert into public.events
    (id, org_id, client_id, producer_id, title, starts_at, ends_at, time_zone,
     area_label, venue_name, address, latitude, longitude, arrival_notes,
     parking_notes, dress_code, status)
  values
    (v_event_a, v_org_a, v_client_a, v_prod_a, 'Desert Classic — Day 1',
     now() + interval '2 days', now() + interval '2 days 8 hours', 'America/Phoenix',
     'Downtown Phoenix, AZ', 'Heritage Hall', '117 N 3rd St, Phoenix, AZ 85004',
     v_phx_lat, v_phx_lng, 'Loading dock on 3rd', 'Garage on Monroe, validated',
     'All black', 'staffed');

  insert into public.briefs (org_id, event_id, summary, body) values
    (v_org_a, v_event_a, 'Hero highlight reel plus 40 edited stills.',
     'Full creative direction: follow the trophy, cover the sponsor wall, ...');

  insert into public.event_contacts (org_id, event_id, kind, name, phone) values
    (v_org_a, v_event_a, 'on_site', 'Dana Client', '+15550111'),
    (v_org_a, v_event_a, 'emergency', 'Venue Security', '+15550999');

  insert into public.shot_list_items (org_id, event_id, title, must_have, position) values
    (v_org_a, v_event_a, 'Trophy presentation', true, 1),
    (v_org_a, v_event_a, 'Sponsor wall', false, 2);

  insert into public.slots
    (id, org_id, event_id, role, rate_type, rate_amount_cents, call_time,
     required_gear, staffing_mode, is_required, status)
  values
    (v_slot_confirmed, v_org_a, v_event_a, 'Lead video', 'flat', 60000,
     now() + interval '2 days', '{camera_body}', 'direct_invite', true, 'filled');

  insert into public.slots
    (id, org_id, event_id, role, rate_type, rate_amount_cents, call_time,
     required_gear, staffing_mode, interest_deadline, is_required, status)
  values
    (v_slot_open, v_org_a, v_event_a, 'Photo', 'day', 45000,
     now() + interval '2 days', '{camera_body}', 'open_call',
     now() + interval '1 day', false, 'open_call');

  insert into public.assignments (id, org_id, slot_id, user_id, status) values
    (v_assign_confirmed, v_org_a, v_slot_confirmed, v_conf, 'confirmed'),
    (v_assign_candidate, v_org_a, v_slot_open, v_cand, 'interested');

  insert into public.deliverables (id, org_id, slot_id, title, spec, due_at) values
    (v_deliverable_a, v_org_a, v_slot_confirmed, '90-second highlight reel',
     '{"format":"ProRes","resolution":"3840x2160","frame_rate":"24"}'::jsonb,
     now() + interval '5 days');

  insert into public.uploads
    (id, org_id, assignment_id, kind, storage_key, filename, bytes, checksum, status)
  values
    (v_upload_a, v_org_a, v_assign_confirmed, 'raw',
     'moments-to-media/desert-classic/2026-11-14_day-1/lead-video_casey/raw/A001.mp4',
     'A001.mp4', 8123456789, 'sha256:aaa', 'completed');

  insert into public.payouts (id, org_id, assignment_id, amount_cents, status) values
    (v_payout_a, v_org_a, v_assign_confirmed, 60000, 'draft');

  insert into public.ratings (org_id, assignment_id, quality, punctuality, communication, rater_id)
  values (v_org_a, v_assign_confirmed, 5, 4, 5, v_prod_a);

  -- ---- event A2: a second producer's own event, for the "own events" cells
  insert into public.events
    (id, org_id, client_id, producer_id, title, starts_at, ends_at, time_zone, status)
  values
    (v_event_a2, v_org_a, v_client_a, v_prod_a2, 'Desert Classic — Day 2',
     now() + interval '3 days', now() + interval '3 days 8 hours', 'America/Phoenix', 'staffing');

  insert into public.slots
    (id, org_id, event_id, role, rate_type, rate_amount_cents, call_time, is_required, status)
  values
    (v_slot_a2, v_org_a, v_event_a2, 'Drone', 'flat', 50000, now() + interval '3 days', true, 'filled');

  insert into public.assignments (id, org_id, slot_id, user_id, status) values
    (v_assign_a2, v_org_a, v_slot_a2, v_conf, 'confirmed');

  insert into public.uploads
    (id, org_id, assignment_id, kind, storage_key, filename, bytes, checksum, status)
  values
    (v_upload_a2, v_org_a, v_assign_a2, 'raw',
     'moments-to-media/desert-classic/2026-11-15_day-2/drone_casey/raw/D001.mp4',
     'D001.mp4', 2123456789, 'sha256:bbb', 'completed');

  insert into public.payouts (id, org_id, assignment_id, amount_cents, status) values
    (v_payout_a2, v_org_a, v_assign_a2, 50000, 'draft');

  -- ---- organization A comms and log
  insert into public.announcements (org_id, author_id, body, pinned) values
    (v_org_a, v_owner_a, 'Reminder: insurance certificates expire in December.', true);

  insert into public.notifications (org_id, user_id, type, channels) values
    (v_org_a, v_conf, 'reminder_24h', '{push,sms}');

  insert into public.activity_log (org_id, actor_id, entity_type, entity_id, action) values
    (v_org_a, v_prod_a, 'event', v_event_a, 'created');

  -- ---- organization B, the other tenant
  insert into public.events
    (id, org_id, client_id, producer_id, title, starts_at, ends_at, time_zone, status)
  values
    (v_event_b, v_org_b, v_client_b, v_owner_b, 'Someone else''s gala',
     now() + interval '4 days', now() + interval '4 days 6 hours', 'America/New_York', 'staffed');

  insert into public.slots
    (id, org_id, event_id, role, rate_type, rate_amount_cents, call_time, is_required, status)
  values
    (v_slot_b, v_org_b, v_event_b, 'Lead photo', 'flat', 30000, now() + interval '4 days', true, 'filled');

  insert into public.assignments (id, org_id, slot_id, user_id, status) values
    (v_assign_b, v_org_b, v_slot_b, v_cont_b, 'confirmed');

  insert into public.uploads
    (id, org_id, assignment_id, kind, storage_key, filename, bytes, checksum, status)
  values
    (v_upload_b, v_org_b, v_assign_b, 'raw', 'other-media-co/gala/raw/B001.jpg',
     'B001.jpg', 12345678, 'sha256:ccc', 'completed');

  insert into public.payouts (id, org_id, assignment_id, amount_cents, status) values
    (v_payout_b, v_org_b, v_assign_b, 30000, 'draft');

  insert into public.briefs (org_id, event_id, summary, body) values
    (v_org_b, v_event_b, 'Gala coverage.', 'Other tenant brief body.');

  insert into public.client_contacts (org_id, client_id, name, phone) values
    (v_org_b, v_client_b, 'Gala Coordinator', '+15550333');
end;
$$;
